# Server Port
PORT=3002

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# GitHub OAuth Application (Create at GitHub -> Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Optional: GitHub Personal Access Token (for higher rate limits when analyzing)
GITHUB_TOKEN=your_github_pat

# Webhook Secret (auto-generated if empty, but good to set explicitly in prod)
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Session Secret
SESSION_SECRET=your_random_session_secret

# Ollama Base URL (Local AI inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_SUMMARY_MODEL=llama3.2
